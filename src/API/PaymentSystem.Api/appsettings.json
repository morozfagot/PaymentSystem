{
  "Serilog": {
    "Using": ["Serilog.Sinks.Console"],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning",
        "Quartz": "Warning",
        "System.Net.Http": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console",
        "Args": {
          "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {CorrelationId} {Message:lj}{NewLine}{Exception}"
        }
      }
    ],
    "Enrich": ["FromLogContext", "WithMachineName", "WithThreadId"]
  },
  "ConnectionStrings": {
    "PaymentsDatabase": "Data Source=/data/payments.db"
  },
  "Payments": {
    "Provider": {
      "BaseUrl": "http://provider-simulator:8081",
      "TimeoutSeconds": 30,
      "RetryCount": 3,
      "BaseDelayMs": 200
    },
    "Outbox": {
      "IntervalInSeconds": 10,
      "BatchSize": 20
    }
  }
}